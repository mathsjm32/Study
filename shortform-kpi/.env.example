# ============================================================
# shortform-kpi 환경 변수
#   1) 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   2) .env 는 절대 커밋하지 마세요 (.gitignore 에 등록되어 있음).
# ============================================================

# ---------- BigQuery ----------
GCP_PROJECT_ID=my-gcp-project
BQ_DATASET=shortform_kpi
BQ_LOCATION=asia-northeast3
# 인증 방식은 둘 중 하나. 둘 다 비우면 gcloud 로그인(ADC)을 사용한다.
#
#  (A) 서비스 계정 키 파일 — 조직 정책이 키 생성을 허용하는 경우
#      GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-sa.json
#
#  (B) gcloud 로그인 (권장) — 키 파일 없이 인증. 아래 둘 다 비워 두면 된다.
#      gcloud auth application-default login
#      조직에 iam.disableServiceAccountKeyCreation 정책이 걸려 있으면 이 방식만 가능.
#
GOOGLE_APPLICATION_CREDENTIALS=
# GitHub Actions: 키 파일 대신 JSON 전체를 한 줄로 넣음 (Secrets 사용)
GCP_SA_JSON=

# ---------- YouTube ----------
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (데스크톱 앱)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# scripts/get_youtube_token.py 를 실행하면 자동으로 발급됩니다
YT_REFRESH_TOKEN=
# 내 채널 ID (UC... 로 시작)
YT_CHANNEL_ID=

# ---------- Meta (Instagram + Facebook 공통) ----------
# 최신 버전은 Meta 개발자 문서의 Graph API Versions 페이지에서 확인 후 갱신하세요.
META_API_VERSION=v26.0
# 비즈니스 관리자의 '시스템 사용자' 토큰 (만료 없음) — 반드시 이것을 사용
META_ACCESS_TOKEN=
# Instagram 비즈니스 계정 ID (숫자). check_auth.py 가 찾아서 알려줍니다.
IG_USER_ID=
# Facebook 페이지 ID (숫자)
FB_PAGE_ID=

# ---------- 알림 (선택, Step 6) ----------
SLACK_WEBHOOK_URL=
